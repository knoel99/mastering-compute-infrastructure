# Generated by Terraform for cluster ${cluster}. DHCP + TFTP for the boot network, DNS disabled.
port=0
interface=${interface}
bind-interfaces

# Static leases only: a machine that is not in the inventory gets no address.
dhcp-range=${server_ip},static
conf-file=${hosts_file}

# Stage 1: the firmware (option 93 = client architecture) receives an iPXE binary over TFTP.
# UEFI x86-64 firmwares announce 7 or 9 depending on the vendor: check a capture from YOUR hardware.
enable-tftp
tftp-root=/srv/tftp
dhcp-match=set:ipxe,175
dhcp-match=set:efi64,option:client-arch,7
dhcp-match=set:efi64,option:client-arch,9
dhcp-boot=tag:!ipxe,tag:efi64,ipxe.efi
dhcp-boot=tag:!ipxe,tag:!efi64,undionly.kpxe

# Stage 2: iPXE (it sends option 175) is handed a script URL instead of itself, which breaks the boot loop.
dhcp-boot=tag:ipxe,http://${server_ip}/${ipxe_script}
