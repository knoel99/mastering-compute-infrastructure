#!ipxe
# Generated by Terraform. The MAC address is the identity of a node: it is what the inventory declares.
set base http://${server_ip}/images
isset $${net0/mac} || goto unknown
%{ for name in names ~}
iseq $${net0/mac} ${nodes[name].mac} && goto node_${replace(name, "-", "_")} ||
%{ endfor ~}
goto unknown

%{ for name in names ~}
:node_${replace(name, "-", "_")}
set hostname ${name}
set profile ${nodes[name].gpus > 0 ? "gpu" : "cpu"}
goto boot

%{ endfor ~}
:unknown
echo MAC $${net0/mac} is not in the inventory: refusing to boot
sleep 5
exit 1

:boot
kernel $${base}/$${profile}/vmlinuz hostname=$${hostname}
initrd $${base}/$${profile}/initrd.img
boot
