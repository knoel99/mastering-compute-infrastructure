# Generated by Terraform for cluster ${cluster}. Do not edit: change the node map instead.
all:
  children:
    gpu_nodes:
      children:
%{ for rack, members in racks ~}
        rack_${replace(rack, "-", "_")}:
          hosts:
%{ for name in members ~}
            ${name}:
              ansible_host: ${nodes[name].ip}
              gpu_model: ${nodes[name].gpu_model}
              gpus: ${nodes[name].gpus}
              bmc_ip: ${nodes[name].bmc_ip}
%{ endfor ~}
%{ endfor ~}
