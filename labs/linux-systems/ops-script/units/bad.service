[Unit]
Description=GPU metrics exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m http.server 9400
Restart=sometimes
RestartSec=5s
LimitNOFILE=1048576
LimitMEMLOCK=infinity
MemoryMax=512M
Delegate=no
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
